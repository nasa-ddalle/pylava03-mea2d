{
    "PBS": {
        "j": "oe",
        "r": "n",
        "S": "/bin/bash",
        "select": 1,
        "ncpus": 128,
        "mpiprocs": 128,
        "model": "rom_ait",
        "W": "group_list=e0847",
        "q": "sls_aero1",
        "walltime": "8:00:00",
        // PBS executables are not on the non-interactive PATH of the
        // SSH target host, so give their location explicitly
        "PBSPrefix": "/PBS/bin"
    },

    // Route qsub/qstat/qdel through SSH when the local host is not a
    // Pleiades front end (e.g. running from Cabeus hosts). Hostname keys
    // are regular expressions matched against the local host; values are
    // the final PBS host, optionally preceded by SSH jump hosts.
    "JumpHosts": {
        "cb.+": ["cfe02", "pfe25"]
    },

    "ShellCmds": [
        ". $MODULESHOME/init/bash",
        "module purge",
        "module use --append /swbuild/LAVA/LAVA_modules",
        "module load LAVA/v1.1.0",
        "module load python3/3.11.5",
        "module use -a /home5/ddalle/share/modulefiles",
        "module load cape/testing"
    ],

    "CartInputFile": "inputs/unst_mea2d.inputs",

    // Settings to copy into each case's "run.inputs" file. This section
    // can be used to override anything in the "CartInputFile" template,
    // and values may be lists (sampled by phase) or "@expr" run matrix
    // expressions. Here we ask LAVA for check-point restart files five
    // times per phase so that cases can be restarted or extended.
    "RunInputs": {
        "unst": {
            "output": {
                "restart": {
                    "interval": 400
                }
            }
        }
    },

    "RunControl": {
        // LAVA architecture: curvilinear | cartesian | unstructured
        "LAVASolver": "unstructured",
        // Iteration control
        "nIter": [2000],
        "PhaseIters": [2000],
        "PhaseSequence": [0],
        // Mode control
        "qsub": true,
        "MPI": true,
        "nProc": 2,
        // Threading (this tutorial: 2 MPI ranks x 32 OpenMP threads)
        "Environ": {
            "OMP_NUM_THREADS": 32
        },
        // MPI launcher. Do not let OpenMPI bind each rank to one core;
        // the 32 OpenMP threads of each rank must be free to spread out
        "mpi": {
            "executable": "mpirun",
            "args": ["--bind-to", "none"]
        },
        // LAVA-Unstructured executable (name depends on architecture;
        // Rome nodes are AVX2)
        "lavaunst": {
            "executable": "lavaunst.3D.NS1.AVX2"
        }
    },

    "Mesh": {
        // Volume mesh generated by the "lavavoro" Voronoi mesher
        "LinkFiles": ["inputs/mesh/voro_mea2d.cgns"]
    },

    "DataBook": {
        "Components": [
            "all",
            "slat",
            "main",
            "flap"
        ],
        // The LAVA solver exits on its own convergence tolerance near
        // iteration 1000, so the nMin+nStats threshold must stay below
        // that. Loads are flat by iteration ~200.
        "nStats": 400,
        "nMin": 400,
        "Folder": "data"
    },

    "Report": {
        "Reports": ["case"],
        "Archive": true,
        "case": {
            "Figures": ["Summary", "QuickHistory", "FlowViz"],
            "Title": "LAVA-U Force, Moment, \\& Residual Report",
            "Subtitle": "pyLava example problem: multielement airfoil",
            "Author": "CAPE Development Team",
            "Affiliation": "NASA ARC/TNA",
            "Logo": "NASA_logo.pdf",
            "Frontispiece": "NASA_logo.pdf",
            "Restriction": "Distribution Unlimited"
        },
        "Figures": {
            "Summary": {
                "Subfigures": ["CaseConds", "CoeffTable"],
                "Alignment": "left"
            },
            "QuickHistory": {
                "Subfigures": [
                    "all_CL", "all_CD", "all_CLM",
                    "parts_CL", "parts_CD", "parts_CLM",
                    "L2"
                ],
                "Header": "Iterative histories",
                "Alignment": "center"
            },
            "FlowViz": {
                "Subfigures": ["p-xz", "p-xz-mesh"],
                "Header": "Flow visualization",
                "Alignment": "center"
            }
        },
        "Subfigures": {
            "CaseConds": {
                "Type": "Conditions",
                "Header": "Conditions",
                "Position": "t",
                "Width": 0.28,
                "SkipVars": []
            },
            "CoeffTable": {
                "Type": "Summary",
                "Header": "Force \\& moment summary",
                "Position": "t",
                "Width": 0.72,
                "Iteration": 0,
                "Components": ["all", "slat", "main", "flap"],
                "Coefficients": ["CL", "CD", "CLM"]
            },
            "IterFM": {
                "Type": "PlotCoeff",
                "Width": 0.33,
                "FigureWidth": 5.5,
                "FigureHeight": 4.2,
                "nAverage": 200,
                "nPlotFirst": 1,
                "StandardDeviation": 1.0,
                "Delta": 0.0025
            },
            "all": {
                "Type": "IterFM",
                "Component": "all",
                "PlotOptions": {
                    "color": "k",
                    "linewidth": 1.5
                }
            },
            "all_CL":  {"Type": "all", "Coefficient": "CL"},
            "all_CD":  {"Type": "all", "Coefficient": "CD"},
            "all_CLM": {"Type": "all", "Coefficient": "CLM"},
            "parts": {
                "Type": "IterFM",
                "Component": ["slat", "main", "flap"],
                "PlotOptions": {
                    "color": ["r", "b", "g"],
                    "linewidth": 1.5
                }
            },
            "parts_CL":  {"Type": "parts", "Coefficient": "CL"},
            "parts_CD":  {"Type": "parts", "Coefficient": "CD"},
            "parts_CLM": {"Type": "parts", "Coefficient": "CLM"},
            "L2": {
                "Type": "PlotL2",
                "Width": 0.33,
                "Caption": "Continuity $L_2$ residual",
                "nPlotFirst": 1,
                "FigureWidth": 5.5,
                "FigureHeight": 4.2
            },
            "p-xz": {
                "Type": "Tecplot",
                "Layout": "inputs/p-xz.lay",
                "Width": 0.85,
                "FigWidth": 2400,
                "Caption": "Pressure contours, $x$--$z$ plane"
            },
            "p-xz-mesh": {
                "Type": "Tecplot",
                "Layout": "inputs/p-xz-mesh.lay",
                "Width": 0.85,
                "FigWidth": 2400,
                "Caption": "Mesh with pressure contours, $x$--$z$ plane"
            }
        }
    },

    "RunMatrix": {
        "File": "matrix.csv",
        "Keys": [
            "mach",
            "alpha",
            "beta",
            "Re",
            "T",
            "config"
        ],
        "Definitions": {
            "mach": {
                "Format": "%.2f"
            },
            "alpha": {
                "Format": "%04.1f"
            },
            "beta": {
                "Format": "%.1f"
            },
            "Re": {
                "Units": "1/m"
            },
            "T": {
                "Units": "K"
            }
        },
        "GroupMesh": false
    }
}
